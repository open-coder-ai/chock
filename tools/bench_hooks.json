        "tool_input": {"command": "ls -la"}
      }
    },
    "Write": {
      "event": "PreToolUse",
      "payload": {
        "hook_event_name": "PreToolUse",
        "session_id": "bench",
        "cwd": "__REPO__",
        "tool_name": "Write",
        "tool_input": {"file_path": "__REPO__/notes/bench.txt", "content": "hello\n"}
      }
    }
  }
}
