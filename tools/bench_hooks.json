{
  "policies": [
    "block-destructive-commands",
    "block-invisible-unicode",
    "block-no-verify",
    "block-wildcard-agent-permissions",
    "pin-github-actions",
    "protect-agent-config",
    "protect-commit-privacy",
    "scan-secrets",
    "token-efficiency"
  ],
  "events": {
    "Bash": {
      "event": "PreToolUse",
      "payload": {
        "hook_event_name": "PreToolUse",
        "session_id": "bench",
