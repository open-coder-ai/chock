_CHOCK_UNREADABLE = (
    "chock could not read this hook's payload, so it could not check the call. "
    "Refusing rather than reporting an allow it never established."
)

#: A payload naming only this vendor's own wire event, so `respond` picks that event's grammar.
_CHOCK_WIRE_RAW = {PRE_TOOL: __PRE_TOOL_RAW__, STOP: __STOP_RAW__}

#: The words a client reads as a refusal, in any of the answer fields a vendor grammar uses.
_CHOCK_REFUSING = ("deny", "block", "ask", "continue")
_CHOCK_ANSWER_KEYS = ("decision", "permission", "permissionDecision")


def _chock_spec_action(path):
    try:
        action = json.loads(path.read_text(encoding="utf-8")).get("action")
    except Exception:
        return "block"
    return action if action in ("ask", "warn") else "block"


def _chock_declared_by(argv):
    """(strictest action, event, gate) of the judging flags in `argv`; (None, None, None) where it judges nothing."""
    actions = ["block"] if guard_path_from_argv(argv) is not None else []
    event = PRE_TOOL
    gate = _flag_path(argv, GATE_FLAG)
    if gate is not None:
        actions.append(_chock_spec_action(gate))
        event = STOP if STOP_FLAG in argv or gate.parent.name == _EVENT_ARG[STOP] else PRE_TOOL
    called = _flag_path(argv, TOOL_CALL_FLAG)
    if called is not None:
        actions.append(_chock_spec_action(called))
    if HALT_HOOK_FLAG in argv and repo_stop_refusal(Event(AGENT, PRE_TOOL, raw={})) is not None:
        actions.append("block")  # stopped: a payload nobody can read is still a call the stop refuses
    for action in ("block", "ask", "warn"):
        if action in actions:
            return action, event, gate
    return None, None, None


def _chock_declared():
    """(strictest action, event, gate) of the judging flags, or of every member of a pinned index; an index that fails its pin blocks."""
    argv = sys.argv[1:]
    pinned = multi_from_argv(argv)
    if pinned is None:
        return _chock_declared_by(argv)
    stopped = _chock_declared_by([HALT_HOOK_FLAG]) if HALT_HOOK_FLAG in argv else (None, None, None)
    if stopped[0] is not None:  # the folded stop check: stopped, an unreadable call is refused whatever the members
        return stopped
    named = root_from_argv(argv)
    members, _why = load_index(
        pinned[0], pinned[1], _chock_Path.cwd() if named is None else named, rooted=named is not None
    )
    if members is None:
        return "block", PRE_TOOL, None
    found = [_chock_declared_by(member["argv"]) for member in members]
    for action in ("block", "ask", "warn"):
        stopping = [f for f in found if f[0] == action and f[1] == STOP]
        if stopping or action in (f[0] for f in found):
            return stopping[0] if stopping else next(f for f in found if f[0] == action)
    return None, None, None


def _chock_refuses(text, code):
    if code == 2:
        return True
    try:
        body = json.loads(text)
    except Exception:
        return False
    if not isinstance(body, dict):
        return False
    nested = body.get("hookSpecificOutput")
    answers = [body] + ([nested] if isinstance(nested, dict) else [])
    return any(part.get(key) in _CHOCK_REFUSING for part in answers for key in _CHOCK_ANSWER_KEYS)


def _chock_unreadable_stop(gate):
    """The bounded verdict of an unreadable Stop: a refusal, or a warning once the cap is spent."""
    root = root_for(gate) or _chock_Path.cwd()
    return settle_unreadable_stop(root, gate.parent.parent.name, _CHOCK_UNREADABLE)


def _chock_runtime_refusal():
    """A refusal in this client's grammar for the event the flags name, read without the shared runtime."""
    _report(_CHOCK_RUNTIME_FAULT + "\n")
    argv = sys.argv[1:]
    gate = argv[argv.index(__GATE_FLAG__) + 1] if __GATE_FLAG__ in argv[:-1] else ""
    stop = __STOP_FLAG__ in argv or _chock_os.path.basename(_chock_os.path.dirname(gate)) == __STOP_DIR__
    event = Event(AGENT, STOP if stop else PRE_TOOL, raw=dict(_CHOCK_WIRE_RAW[STOP if stop else PRE_TOOL]))
    text, code = __RESPOND__(degrade(Decision.deny(_CHOCK_RUNTIME_FAULT), event), event)
    return (text, code) if _chock_refuses(text, code) else ("", 2)


def _chock_unreadable():
    if _CHOCK_RUNTIME_FAULT is not None:
        return _chock_runtime_refusal()
    action, kind, gate = _chock_declared()
    if action in (None, "warn"):
        return "", 0
    event = Event(AGENT, kind, raw=dict(_CHOCK_WIRE_RAW[kind]))
    reason = _CHOCK_UNREADABLE
    if kind == STOP and gate is not None:
        verdict, reason = _chock_unreadable_stop(gate)
        if verdict == VERDICT_WARN:
            return __WARN_RESPOND__(degrade(Decision.warn(reason), event), event)
    _report(reason + "\n")
    decision = Decision.escalate(reason) if action == "ask" else Decision.deny(reason)
    judged = ["unreadable", None, _chock_time.monotonic(), {}]
    log_decision(sys.argv[1:], event, decision, judged, {"manifests": _CHOCK_PLUGIN_MANIFESTS})
    text, code = __RESPOND__(degrade(decision, event), event)
    return (text, code) if _chock_refuses(text, code) else ("", 2)
