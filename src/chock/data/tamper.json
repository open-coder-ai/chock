{
  "$comment": "Facts `chock check --floor` compares merge-base against head. Ships inside the engine, so a pull request cannot edit what judges it.",
  "hook_files": [
    {"glob": ".claude/settings.json", "pointer": "/hooks", "vendor": "claude_code"},
    {"glob": ".cursor/hooks.json", "pointer": "/hooks", "vendor": "cursor"},
    {"glob": ".github/hooks/*.json", "pointer": "/hooks", "vendor": "vscode_copilot"},
    {"glob": ".codex/hooks.json", "pointer": "/hooks", "vendor": "codex_cli"},
    {"glob": ".gemini/settings.json", "pointer": "/hooks", "vendor": "gemini_cli"},
    {"glob": ".windsurf/hooks.json", "pointer": "/hooks", "vendor": "windsurf"},
    {"glob": ".devin/hooks.json", "pointer": "/hooks", "vendor": "devin"},
    {"glob": ".devin/hooks.v1.json", "pointer": "", "vendor": "devin"},
    {"glob": ".grok/hooks/*.json", "pointer": "/hooks", "vendor": "grok"}
  ],
  "$comment_switches": "Per vendor: keys that switch every hook off (a JSON pointer into its hook file, refused when truthy at the head and not at the merge-base) and the higher-precedence files a repository can commit (refused when added or changed carrying hooks or a disable key). A vendor with no entry is printed as not covered.",
  "hook_switches": {
    "claude_code": {
      "disable_keys": ["/disableAllHooks"],
      "override_files": [".claude/settings.local.json"]
    }
  },
  "hook_nested_key": "hooks",
  "hook_matcher_key": "matcher",
  "hook_matcher_separator": "|",
  "hook_type_key": "type",
  "hook_type_default": "command",
  "hook_command_keys": ["command", "commandWindows", "bash", "powershell", "prompt"],
  "$comment_volatile": "Only the index pin a regeneration rewrites; the index file it pins must itself equal the merge-base or this engine's render.",
  "volatile_pattern": "(?<=--index-sha256 )[0-9a-f]{64}",
  "volatile_placeholder": "<sha256>",
  "compiled_prefix": ".chock/compiled/",
  "policies_prefix": ".agents/policies/",
  "gate_surfaces": ["ci-gate", "git-hook"],
  "gate_file": "gate.json",
  "runtime_prefix": ".chock/bin/",
  "index_prefix": ".chock/bin/index/",
  "launcher": ".chock/bin/launch.sh",
  "lock_file": "chock.lock",
  "workflow_default": ".github/workflows/chock.yml",
  "workflow_config_key": "floor_workflow"
}
