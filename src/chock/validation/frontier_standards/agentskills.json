    "max_length": 1024,
    "min_length": 1
  },
  "compatibility": {
    "max_length": 500
  },
  "skill_md_body": {
    "max_lines": 500,
    "max_tokens": 5000
  },
  "references": {
    "one_level_deep_from_skill_md": true
  },
  "directories": {
    "required": [
      "SKILL.md"
    ],
    "optional": [
      "scripts/",
      "references/",
      "assets/"
    ]
