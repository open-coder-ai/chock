{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-coder-ai.github.io/chock/schemas/v0/bundles.schema.json",
  "title": "ChockPluginBundles",
  "description": "bundles.yaml: named sets of policies installed as one plugin per client.",
  "type": "object",
  "required": ["bundles"],
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "description", "members"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$", "maxLength": 64},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1, "description": "What the set is for; enforcement is derived from the members, never written here."},
          "members": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$", "maxLength": 64}
          }
        }
      }
    }
  }
}
