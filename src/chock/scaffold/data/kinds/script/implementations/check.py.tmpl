#!/usr/bin/env python3
"""__NAME__: judge the files a change writes. Reads {"event", "repo_root", "writes": {path: text}} on stdin.

Exit 0 allows, 1 refuses, 3 asks, 4 warns; the reason goes to stderr.
"""

from __future__ import annotations

import json
import sys
from pathlib import PurePosixPath

#: Edit these: a path whose name is in REFUSE is refused; one in ASK waits for the person's yes.
REFUSE = {".env"}
ASK = {"package-lock.json", "poetry.lock", "Cargo.lock"}


def main() -> int:
    writes = json.load(sys.stdin).get("writes") or {}
    names = {path: PurePosixPath(path).name for path in writes}
    refused = sorted(path for path, name in names.items() if name in REFUSE)
    if refused:
        print(f"__ID__: {', '.join(refused)} must not be committed.", file=sys.stderr)
        return 1
    asked = sorted(path for path, name in names.items() if name in ASK)
    if asked:
        print(f"__ID__: {', '.join(asked)} changed; a person confirms it first.", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
