#!/usr/bin/env python3
"""__NAME__: judge one shell command before it runs. Exit 0 allows, 1 refuses, 3 asks; the reason goes to stderr."""

from __future__ import annotations

import os
import re
import sys

#: A command matching BLOCK is refused; one matching ASK waits for the person's yes. Edit both.
BLOCK = re.compile(r"\bterraform\s+destroy\b|\bterraform\s+apply\b.*\s-destroy\b")
ASK = re.compile(r"\bterraform\s+state\s+rm\b")


def main(argv: list[str]) -> int:
    command = os.environ.get("CHOCK_RAW_COMMAND") or " ".join(argv)
    if BLOCK.search(command):
        print("__ID__: this command is refused. Run it yourself after review.", file=sys.stderr)
        return 1
    if ASK.search(command):
        print("__ID__: this command needs a person's yes first.", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
