# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/

# Chock runtime outputs
optimization-log.yaml
rejected-edits/
.tmp_gate_baseline/
# Gate outcome evidence: local to the machine that ran the hook, never shared state.
.chock/log/

# Skill schemas are injected by `chock install-skills`
.agents/skills/**/assets/manifest*.json

# Skills bridge is generated by `chock sync` — .agents/skills is the source of truth
.claude/skills/

# Session-local Claude Code hook registration (written by `chock sync`);
# tracking it flips PreToolUse coverage to 'enforced' for every clone -- see test_coverage_honesty.
# .claude/settings.json is COMMITTED (like the catalog's): it holds only chock-managed
# hook entries, and interpreter normalisation makes the coverage verdict machine-independent.
# Ignoring it made every local sync derive claims CI could not reproduce.

# Promo render intermediates: regenerated by render_frames.py / gen_audio.py; only
# the sources and the muxed mp4 are content.
docs/assets/promo/frames/
docs/assets/promo/frames_test/
docs/assets/promo/audio_work/
docs/assets/promo/audio.wav
